---
import { BUSINESS } from "../config/business";
import { fill, t, type Locale } from "../i18n";

interface Props { locale: Locale; class?: string }
const { locale, class: className = "" } = Astro.props;
const d = t(locale);
---

{/*
  Open/closed cannot be decided at build time — a prerendered "Open now" is
  wrong for most of the day it is cached. So the honest, always-true opening
  hours render server-side, and the script upgrades them to a live status in
  Barcelona's clock. No JS, no lie.
*/}
<div class={`flex items-center gap-2.5 text-sm ${className}`} data-open-now>
  <span class="size-2 shrink-0 rounded-full bg-white/40" data-dot aria-hidden="true"></span>
  <span class="tnum" data-status>{fill(d.hero.everyDayHours)}</span>
</div>

<script
  is:inline
  define:vars={{
    hours: BUSINESS.hours,
    labels: {
      open: d.hero.availableNow,
      closed: d.hero.closedNow,
      until: d.hero.todayUntil,
      opensAt: d.hero.opensAt,
    },
  }}
>
  (() => {
    // A page can carry more than one call panel — the home page has one in the
    // hero and another at the foot — and this inline script is emitted once per
    // instance. querySelector would leave every panel after the first showing
    // the static hours while the first is updated twice, so every instance
    // updates every panel; the work is idempotent.
    const roots = document.querySelectorAll("[data-open-now]");
    if (!roots.length) return;

    // The business is in Barcelona; the visitor may not be. Formatting "now"
    // into Europe/Madrid means someone reading this from London is told
    // whether the workshop is open, not whether their own clock says so.
    const parts = new Intl.DateTimeFormat("en-GB", {
      timeZone: "Europe/Madrid", hour: "2-digit", minute: "2-digit", hour12: false,
    }).formatToParts(new Date());
    const get = (type) => parts.find((p) => p.type === type)?.value ?? "0";

    const minutes = Number(get("hour")) * 60 + Number(get("minute"));
    const toMinutes = (hhmm) => Number(hhmm.slice(0, 2)) * 60 + Number(hhmm.slice(3, 5));
    // Same hours seven days a week, so the weekday never enters the decision.
    const isOpen = minutes >= toMinutes(hours.open) && minutes < toMinutes(hours.close);

    for (const root of roots) {
      const dot = root.querySelector("[data-dot]");
      const status = root.querySelector("[data-status]");
      if (!dot || !status) continue;

      dot.style.background = isOpen ? "var(--color-live)" : "var(--color-orange)";
      dot.style.boxShadow = isOpen
        ? "0 0 0 3px color-mix(in srgb, var(--color-live) 30%, transparent)"
        : "none";
      status.textContent = isOpen
        ? `${labels.open} · ${labels.until} ${hours.close}`
        : `${labels.closed} · ${labels.opensAt} ${hours.open}`;
    }
  })();
</script>
