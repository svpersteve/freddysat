---
import { BUSINESS } from "../config/business";
import { t, type Locale } from "../i18n";

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = t(locale);
const f = d.contact.form;

const field = "w-full border border-steel bg-white px-3.5 py-2.5 text-sm text-ink placeholder:text-ink-45/70 transition-colors duration-200 focus:border-orange focus:outline-none focus-visible:outline-none";
const label = "block label";

// The symptom chips on the home page arrive here as ?s=<id>. Passing the
// dictionary's own labels down means the prefilled sentence is in the same
// language as the page the visitor clicked from.
const symptomLabels = Object.fromEntries(d.symptoms.map((s) => [s.id, s.label]));
---

<form class="grid gap-5 border border-steel bg-paper-shade p-6 sm:p-8" data-wa-form novalidate>
  <h2 class="font-display text-xl font-bold leading-tight">{f.title}</h2>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label class={label} for="wa-name">{f.name}</label>
      <input class={`mt-1.5 ${field}`} id="wa-name" name="name" type="text" autocomplete="name" placeholder={f.namePlaceholder} />
    </div>
    <div>
      <label class={label} for="wa-area">{f.area}</label>
      <input class={`mt-1.5 ${field}`} id="wa-area" name="area" type="text" placeholder={f.areaPlaceholder} />
    </div>
    <div>
      <label class={label} for="wa-appliance">{f.appliance} <span class="ml-1 inline-block size-1.5 bg-orange align-middle" aria-hidden="true"></span></label>
      <input class={`mt-1.5 ${field}`} id="wa-appliance" name="appliance" type="text" required placeholder={f.appliancePlaceholder} />
    </div>
    <div>
      <label class={label} for="wa-brand">{f.brand}</label>
      <input class={`mt-1.5 ${field}`} id="wa-brand" name="brand" type="text" placeholder={f.brandPlaceholder} />
    </div>
  </div>

  <div>
    <label class={label} for="wa-problem">{f.problem} <span class="ml-1 inline-block size-1.5 bg-orange align-middle" aria-hidden="true"></span></label>
    <textarea class={`mt-1.5 ${field} min-h-28 resize-y`} id="wa-problem" name="problem" required placeholder={f.problemPlaceholder}></textarea>
  </div>

  <p class="hidden border-l-[5px] border-orange bg-orange-wash px-3 py-2 text-sm text-ink" role="alert" data-wa-error>{f.required}</p>

  <div class="flex flex-col gap-4 sm:flex-row sm:items-center">
    <button
      type="submit"
      class="inline-flex shrink-0 items-center justify-center gap-2.5 bg-ink px-6 py-3.5 text-sm font-medium text-white transition-colors duration-200 hover:bg-orange"
    >
      <svg class="size-5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12.04 2c-5.46 0-9.9 4.44-9.9 9.9 0 1.75.46 3.45 1.32 4.95L2 22l5.3-1.38a9.86 9.86 0 0 0 4.74 1.2h.01c5.46 0 9.9-4.44 9.9-9.9 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.02h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.11.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.37c0-4.54 3.7-8.23 8.23-8.23a8.2 8.2 0 0 1 8.22 8.24c0 4.54-3.69 8.22-8.22 8.22Z"/>
      </svg>
      {f.submit}
    </button>
    <p class="text-xs leading-relaxed text-ink-45">{f.note}</p>
  </div>
</form>

<script
  is:inline
  define:vars={{
    waNumber: BUSINESS.whatsapp,
    symptomLabels,
    intro:
      locale === "ca" ? "Hola, escric des de la web." :
      locale === "en" ? "Hello, I'm writing from your website." :
      "Hola, escribo desde la web.",
    fieldNames: {
      name: f.name,
      area: f.area,
      appliance: f.appliance,
      brand: f.brand,
      problem: f.problem,
    },
  }}
>
  (() => {
    const form = document.querySelector("[data-wa-form]");
    if (!form) return;

    const error = form.querySelector("[data-wa-error]");
    const get = (name) => form.querySelector(`[name="${name}"]`);

    // A symptom chip on the home page links here as ?s=no-desagua. Seeding the
    // textarea with that label means the visitor lands with the sentence they
    // already chose, rather than an empty box asking them to describe it again.
    const symptom = new URLSearchParams(window.location.search).get("s");
    const problem = get("problem");
    if (symptom && symptomLabels[symptom] && problem && !problem.value) {
      problem.value = symptomLabels[symptom];
      problem.focus();
      // Caret to the end so they type after the label, not before it.
      problem.setSelectionRange(problem.value.length, problem.value.length);
    }

    form.addEventListener("submit", (event) => {
      event.preventDefault();

      const values = {};
      for (const key of ["name", "area", "appliance", "brand", "problem"]) {
        values[key] = (get(key)?.value ?? "").trim();
      }

      if (!values.appliance || !values.problem) {
        error?.classList.remove("hidden");
        (values.appliance ? get("problem") : get("appliance"))?.focus();
        return;
      }
      error?.classList.add("hidden");

      const lines = [intro, ""];
      for (const key of ["name", "area", "appliance", "brand", "problem"]) {
        if (values[key]) lines.push(`${fieldNames[key]}: ${values[key]}`);
      }

      // Opened rather than sent: WhatsApp shows the draft and the visitor still
      // has to press send, which is what the note under the button promises.
      window.open(`https://wa.me/${waNumber}?text=${encodeURIComponent(lines.join("\n"))}`, "_blank", "noopener");
    });
  })();
</script>
