---
import Mark from "./Mark.astro";
import LangSwitch from "./LangSwitch.astro";
import { BUSINESS } from "../config/business";
import { pathFor, t, type Locale, type PageKey } from "../i18n";

interface Props { locale: Locale; page: PageKey }
const { locale, page } = Astro.props;
const d = t(locale);

const links: { key: PageKey; label: string }[] = [
  { key: "services", label: d.nav.services },
  { key: "aircon", label: d.nav.aircon },
  { key: "areas", label: d.nav.areas },
  { key: "contact", label: d.nav.contact },
];
---

<header class="sticky top-0 z-40 bg-graphite text-white">
  <div class="wrap flex h-16 items-center justify-between gap-4">
    <a href={pathFor(locale, "home")} class="flex items-center gap-2.5 shrink-0" aria-label={BUSINESS.name}>
      <Mark class="size-7" />
      <span class="font-display text-lg font-bold tracking-tight leading-none">
        Freddy<span class="text-graphite-45 font-normal">·</span>SAT
      </span>
    </a>

    <nav class="hidden lg:flex items-center gap-1" aria-label={d.nav.menu}>
      {
        links.map((l) => (
          <a
            href={pathFor(locale, l.key)}
            aria-current={l.key === page ? "page" : undefined}
            class:list={[
              "px-3 py-2 text-sm transition-colors duration-200",
              l.key === page ? "text-white" : "text-white/65 hover:text-white",
            ]}
          >
            {l.label}
            {l.key === page && <span class="block h-0.5 bg-ember mt-1.5 -mb-2" aria-hidden="true" />}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2 md:gap-3">
      <LangSwitch locale={locale} page={page} class="hidden sm:flex" />

      {/* The phone number is the whole point of the site, so it never leaves the
          viewport on desktop. On mobile the sticky CallBar does this job with a
          bigger target, so the header keeps only the compact icon. */}
      <a
        href={`tel:${BUSINESS.phone.tel}`}
        class="hidden md:flex items-center gap-2 bg-ember px-4 py-2.5 font-mono text-sm font-medium text-white transition-colors duration-200 hover:bg-ember-bright"
        data-call-link
      >
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
          <path d="M4 3h3.5l1.8 4.5-2.2 1.6a12 12 0 0 0 5.8 5.8l1.6-2.2L19 14.5V18a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 2 5.2 2 2 0 0 1 4 3Z" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        {BUSINESS.phone.display}
      </a>

      <button
        type="button"
        class="lg:hidden -mr-2 p-2 text-white"
        aria-label={d.nav.menu}
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-menu-toggle
      >
        <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="hidden lg:hidden border-t border-white/10 bg-graphite" data-menu-panel>
    <nav class="wrap flex flex-col py-2" aria-label={d.nav.menu}>
      {
        links.map((l) => (
          <a
            href={pathFor(locale, l.key)}
            aria-current={l.key === page ? "page" : undefined}
            class:list={[
              "border-b border-white/8 py-3.5 text-base transition-colors duration-200 last:border-0",
              l.key === page ? "text-ember-bright" : "text-white/80",
            ]}
          >
            {l.label}
          </a>
        ))
      }
      <LangSwitch locale={locale} page={page} class="sm:hidden pt-3 pb-1" />
    </nav>
  </div>
</header>

<script>
  // Progressive enhancement: the panel markup is in the page and simply
  // unhidden, so the links are crawlable and work if this script never runs.
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const panel = document.querySelector<HTMLElement>("[data-menu-panel]");

  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    panel?.classList.toggle("hidden", open);
  });

  // Escape closes it and returns focus to the control that opened it, which is
  // the part keyboard users notice missing.
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || toggle?.getAttribute("aria-expanded") !== "true") return;
    toggle.setAttribute("aria-expanded", "false");
    panel?.classList.add("hidden");
    toggle.focus();
  });
</script>
