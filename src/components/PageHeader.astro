---
interface Props { label: string; title: string; lead?: string }
const { label, title, lead } = Astro.props;
---

<section class="border-b border-paper-edge bg-white">
  <div class="wrap py-12 md:py-16">
    <p class="label">{label}</p>
    <h1 class="mt-3 max-w-3xl text-[clamp(2rem,5.5vw,3.5rem)]">{title}</h1>
    {lead && <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-70">{lead}</p>}
  </div>
</section>
