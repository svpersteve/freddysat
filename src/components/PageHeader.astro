---
interface Props { eyebrow: string; title: string; lead?: string }
const { eyebrow, title, lead } = Astro.props;
---

<section class="border-b border-steel-soft bg-white">
  <div class="wrap py-12 md:py-16">
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="mt-3 max-w-3xl text-[clamp(2rem,5.5vw,3.5rem)]">{title}</h1>
    {lead && <p class="mt-5 max-w-2xl text-lg leading-relaxed text-graphite-70">{lead}</p>}
  </div>
</section>
