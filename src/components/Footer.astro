---
import Wordmark from "./Wordmark.astro";
import { AREAS, BUSINESS } from "../config/business";
import { pathFor, t, type Locale, type PageKey } from "../i18n";

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = t(locale);
const year = new Date().getFullYear();

const serviceLinks: { key: PageKey; label: string }[] = [
  { key: "services", label: d.nav.services },
  { key: "areas", label: d.nav.areas },
  { key: "contact", label: d.nav.contact },
];
---

<footer class="bg-ink text-white/70">
  <div class="wrap grid gap-10 py-14 md:grid-cols-2 lg:grid-cols-4 lg:gap-8">
    <div class="lg:col-span-2 lg:max-w-sm">
      <Wordmark variant="reversed" class="text-[2rem]" />
      <p class="mt-4 text-sm leading-relaxed">{d.footer.blurb}</p>

      <div class="mt-6 space-y-1.5 text-sm tnum">
        <a href={`tel:${BUSINESS.phone.tel}`} class="block text-white underline-offset-4 transition-opacity hover:underline" data-call-link>
          {BUSINESS.phone.display}
        </a>
        {
          BUSINESS.email && (
            <a href={`mailto:${BUSINESS.email}`} class="block transition-colors hover:text-white">
              {BUSINESS.email}
            </a>
          )
        }
      </div>
    </div>

    <nav aria-labelledby="footer-services">
      <h2 id="footer-services" class="label text-white/40">{d.footer.services}</h2>
      <ul class="mt-4 space-y-2.5 text-sm">
        {
          serviceLinks.map((l) => (
            <li>
              <a href={pathFor(locale, l.key)} class="transition-colors duration-200 hover:text-white">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <h2 class="label text-white/40">{d.contact.hoursLabel}</h2>
      <p class="mt-4 flex items-baseline justify-between gap-3 text-sm">
        <span>{d.contact.everyDay}</span>
        <span class="font-bold text-white tnum">{BUSINESS.hours.open}–{BUSINESS.hours.close}</span>
      </p>

      <a
        href={BUSINESS.google.profileUrl}
        target="_blank"
        rel="noopener"
        class="mt-5 inline-flex items-center gap-2 border border-white/30 px-3.5 py-2 text-xs transition-colors duration-200 hover:border-white hover:bg-white/10"
      >
        <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z"/>
        </svg>
        {d.footer.googleProfile}
      </a>

      <h2 class="label mt-7 text-white/40">{d.contact.areaLabel}</h2>
      <p class="mt-3 text-xs leading-relaxed">{AREAS.join(" · ")}</p>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="wrap flex flex-col gap-4 py-6 text-xs md:flex-row md:items-center md:justify-between">
      <p class="max-w-2xl leading-relaxed text-white/45">{d.footer.legalNote}</p>
      <div class="flex shrink-0 flex-wrap items-center gap-x-5 gap-y-2">
        <a href={pathFor(locale, "legal")} class="transition-colors duration-200 hover:text-white">{d.footer.legal}</a>
        <a href={pathFor(locale, "privacy")} class="transition-colors duration-200 hover:text-white">{d.footer.privacy}</a>
        <span class="text-white/40">© {year} {BUSINESS.name}</span>
      </div>
    </div>
  </div>
</footer>
