---
import Mark from "./Mark.astro";
import { AREAS, BUSINESS } from "../config/business";
import { pathFor, t, type Locale, type PageKey } from "../i18n";

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = t(locale);
const year = new Date().getFullYear();

const serviceLinks: { key: PageKey; label: string }[] = [
  { key: "services", label: d.nav.services },
  { key: "aircon", label: d.nav.aircon },
  { key: "areas", label: d.nav.areas },
  { key: "contact", label: d.nav.contact },
];
---

<footer class="bg-graphite text-white/70">
  <div class="wrap grid gap-10 py-14 md:grid-cols-2 lg:grid-cols-4 lg:gap-8">
    <div class="lg:col-span-2 lg:max-w-sm">
      <div class="flex items-center gap-2.5">
        <Mark class="size-6" />
        <span class="font-display text-base font-bold text-white">Freddy<span class="text-white/40 font-normal">·</span>SAT</span>
      </div>
      <p class="mt-4 text-sm leading-relaxed">{d.footer.blurb}</p>

      <div class="mt-6 space-y-1.5 font-mono text-sm">
        <a href={`tel:${BUSINESS.phone.tel}`} class="block text-white transition-colors hover:text-ember-bright" data-call-link>
          {BUSINESS.phone.display}
        </a>
        <a href={`mailto:${BUSINESS.email}`} class="block transition-colors hover:text-white">{BUSINESS.email}</a>
      </div>
    </div>

    <nav aria-labelledby="footer-services">
      <h2 id="footer-services" class="eyebrow text-white/40">{d.footer.services}</h2>
      <ul class="mt-4 space-y-2.5 text-sm">
        {
          serviceLinks.map((l) => (
            <li>
              <a href={pathFor(locale, l.key)} class="transition-colors duration-200 hover:text-white">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <h2 class="eyebrow text-white/40">{d.contact.hoursLabel}</h2>
      <dl class="mt-4 space-y-2 font-mono text-xs">
        <div class="flex justify-between gap-3">
          <dt>{d.contact.weekdays}</dt>
          <dd class="text-white">{BUSINESS.hours.weekdays.open}–{BUSINESS.hours.weekdays.close}</dd>
        </div>
        <div class="flex justify-between gap-3">
          <dt>{d.contact.saturday}</dt>
          <dd class="text-white">{BUSINESS.hours.saturday.open}–{BUSINESS.hours.saturday.close}</dd>
        </div>
        <div class="flex justify-between gap-3">
          <dt>{d.contact.sunday}</dt>
          <dd>{d.contact.closed}</dd>
        </div>
      </dl>

      <h2 class="eyebrow mt-7 text-white/40">{d.contact.areaLabel}</h2>
      <p class="mt-3 text-xs leading-relaxed">{AREAS.slice(0, 6).join(" · ")} …</p>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="wrap flex flex-col gap-4 py-6 text-xs md:flex-row md:items-center md:justify-between">
      <p class="max-w-2xl leading-relaxed text-white/45">{d.footer.legalNote}</p>
      <div class="flex shrink-0 flex-wrap items-center gap-x-5 gap-y-2">
        <a href={pathFor(locale, "legal")} class="transition-colors duration-200 hover:text-white">{d.footer.legal}</a>
        <a href={pathFor(locale, "privacy")} class="transition-colors duration-200 hover:text-white">{d.footer.privacy}</a>
        <span class="font-mono text-white/35">© {year} {BUSINESS.name}</span>
      </div>
    </div>
  </div>
</footer>
