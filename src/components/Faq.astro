---
import { fill, t, type Locale } from "../i18n";

interface Props {
  locale: Locale;
  /** Ids to render, in this order. Omitted renders the whole deck. */
  pick?: readonly string[];
  /**
   * Emits the FAQPage node, which always carries the *whole* deck rather than
   * whatever this instance renders. Only one page may set it: two FAQPage nodes
   * on two URLs describing the same six questions is duplicate structured data.
   */
  schema?: boolean;
}
const { locale, pick, schema = false } = Astro.props;
const d = t(locale);

const byId = new Map(d.faq.items.map((item) => [item.id, item]));
const items = pick ? pick.flatMap((id) => { const item = byId.get(id); return item ? [item] : []; }) : d.faq.items;

// FAQPage markup earns the expandable answers in Google's results, which for a
// query like "¿cuánto cuesta arreglar una lavadora?" is most of the click.
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: d.faq.items.map((item) => ({
    "@type": "Question",
    name: fill(item.q),
    acceptedAnswer: { "@type": "Answer", text: fill(item.a) },
  })),
};
---

<section class="border-b border-paper-edge bg-white py-16 md:py-24">
  <div class="wrap grid gap-10 lg:grid-cols-[0.7fr_1.3fr] lg:gap-16">
    <div>
      <p class="label">{d.faq.label}</p>
      <h2 class="mt-3 text-[clamp(1.875rem,4.5vw,2.75rem)]">{d.faq.title}</h2>
    </div>

    {/* Native details/summary: keyboard-operable and expanded by find-in-page
        without a line of JavaScript. */}
    <div class="border-t border-paper-edge">
      {
        items.map((item) => (
          <details class="group border-b border-paper-edge">
            <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-5 font-display text-base font-bold leading-snug underline-offset-4 transition-all duration-200 hover:underline [&::-webkit-details-marker]:hidden">
              {fill(item.q)}
              <span
                class="mt-0.5 shrink-0 text-ink-45 transition-transform duration-200 group-open:rotate-45"
                aria-hidden="true"
              >
                <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 5v14M5 12h14" stroke-linecap="round" />
                </svg>
              </span>
            </summary>
            <p class="max-w-2xl pb-6 text-sm leading-relaxed text-ink-70">{fill(item.a)}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

{schema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />}
