---
import { fill, t, type Locale } from "../i18n";

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = t(locale);
---

<section class="border-b border-steel-soft bg-white py-16 md:py-24">
  <div class="wrap grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
    <div>
      <p class="eyebrow">{d.trust.eyebrow}</p>
      <h2 class="mt-3 text-[clamp(1.875rem,4.5vw,2.75rem)]">{d.trust.title}</h2>
      <p class="mt-4 text-lg leading-relaxed text-graphite-70">{d.trust.lead}</p>
    </div>

    <ul class="grid gap-px self-start bg-steel-soft sm:grid-cols-2">
      {
        d.trust.points.map((point) => (
          <li class="bg-white p-6">
            <h3 class="font-display text-base font-bold leading-tight">{fill(point.title)}</h3>
            <p class="mt-2.5 text-sm leading-relaxed text-graphite-70">{fill(point.body)}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
