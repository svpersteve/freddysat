---
import { LOCALES, DICTS, pathFor, type Locale, type PageKey } from "../i18n";

interface Props { locale: Locale; page: PageKey; class?: string; dark?: boolean }
const { locale, page, class: className = "", dark = false } = Astro.props;
---

{/* Links to the *equivalent* page in each language, not to its home page —
    /servicios/ swaps to /en/services/. Losing your place is the usual bug in a
    language switcher and the main reason slugs are held in the dictionaries. */}
<nav class={`flex items-center text-xs ${className}`} aria-label="Idioma">
  {
    LOCALES.map((l, i) => (
      <>
        {i > 0 && <span class:list={["px-0.5", dark ? "text-white/25" : "text-steel"]} aria-hidden="true">/</span>}
        <a
          href={pathFor(l, page)}
          hreflang={DICTS[l].htmlLang}
          lang={DICTS[l].htmlLang}
          aria-current={l === locale ? "true" : undefined}
          class:list={[
            "label px-1.5 py-1 transition-colors duration-200",
            dark
              ? l === locale ? "text-white" : "text-white/50 hover:text-white"
              : l === locale ? "text-ink" : "text-ink-45 hover:text-ink",
          ]}
          title={DICTS[l].localeName}
        >
          {l}
        </a>
      </>
    ))
  }
</nav>
