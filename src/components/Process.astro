---
import { t, type Locale } from "../i18n";

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = t(locale);
---

<section class="border-b border-paper-edge py-16 md:py-24">
  <div class="wrap">
    <p class="label">{d.process.label}</p>
    <h2 class="mt-3 max-w-xl text-[clamp(1.875rem,4.5vw,2.75rem)]">{d.process.title}</h2>

    {/* Numbered because this genuinely is a sequence — the customer cannot be
        at step three before step one. Nothing else on the site is numbered. */}
    <ol class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">
      {
        d.process.steps.map((step, i) => (
          <li class="border-t-[5px] border-orange pt-4">
            <span class="label text-ink-45">
              {String(i + 1).padStart(2, "0")}
            </span>
            <h3 class="mt-2 font-display text-lg font-bold leading-tight">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-70">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
