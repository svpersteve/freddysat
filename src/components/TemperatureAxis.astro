---
import { pathFor, t, type Locale } from "../i18n";

interface Props { locale: Locale; showCta?: boolean }
const { locale, showCta = true } = Astro.props;
const d = t(locale);
const items = d.catalogue;

/**
 * The axis is computed, not decorated.
 *
 * Every service sits at a position between the two poles of the trade — things
 * that make heat and things that take it away — and its accent is that
 * position, mixed live between the brand orange and ink. Reordering
 * `catalogue` recolours the section automatically, so no card can drift out of
 * sync with the gradient above it.
 *
 * Orange to ink rather than orange to a second hue: the guide allows exactly
 * one accent, so the cold end is the absence of it.
 */
const accentAt = (index: number) => {
  const heat = items.length > 1 ? 100 - (index / (items.length - 1)) * 100 : 50;
  return `color-mix(in oklab, var(--color-orange) ${heat.toFixed(1)}%, var(--color-ink))`;
};
---

<section id="servicios" class="border-b border-paper-edge py-16 md:py-24">
  <div class="wrap">
    <div class="max-w-2xl">
      <p class="label">{d.services.label}</p>
      <h2 class="mt-3 text-[clamp(1.875rem,4.5vw,3rem)]">{d.services.title}</h2>
      <p class="mt-4 text-lg leading-relaxed text-ink-70">{d.services.lead}</p>
    </div>

    {/* The spine. Labels the poles the cards below are sorted between. */}
    <div class="mt-12 flex items-center gap-4">
      <span class="label shrink-0">{d.services.hotLabel}</span>
      <div
        class="h-1.5 flex-1"
        style="background:linear-gradient(90deg,var(--color-orange),var(--color-ink))"
        aria-hidden="true"
      >
      </div>
      <span class="label shrink-0">{d.services.coldLabel}</span>
    </div>
    <p class="mt-3 text-xs text-ink-45">{d.services.axisNote}</p>

    <ul class="mt-6 grid gap-px bg-paper-edge sm:grid-cols-2 lg:grid-cols-4">
      {
        items.map((service, i) => (
          <li class="flex flex-col bg-white p-5 transition-colors duration-200 hover:bg-paper-shade">
            <span class="h-1.5 w-12 shrink-0" style={`background:${accentAt(i)}`} aria-hidden="true" />
            <h3 class="mt-4 font-display text-lg font-bold leading-tight">{service.name}</h3>
            <p class="mt-2.5 flex-1 text-sm leading-relaxed text-ink-70">{service.blurb}</p>

            <p class="label mt-5 text-[0.625rem]">{d.services.common}</p>
            <ul class="mt-2 space-y-1">
              {service.faults.map((fault) => (
                <li class="flex gap-2 text-[0.8125rem] leading-snug text-ink-70">
                  <span class="text-ink-45" aria-hidden="true">—</span>
                  <span>{fault}</span>
                </li>
              ))}
            </ul>
          </li>
        ))
      }

      {
        showCta && (
          <li class="flex flex-col justify-between bg-ink p-5 text-white">
            <div>
              <span class="h-1.5 w-12 shrink-0 block bg-orange" aria-hidden="true" />
              <h3 class="mt-4 font-display text-lg font-bold leading-tight">{d.aircon.title}</h3>
              <p class="mt-2.5 text-sm leading-relaxed text-white/65">{d.aircon.seasonBody}</p>
            </div>
            <a
              href={pathFor(locale, "aircon")}
              class="mt-5 inline-flex items-center gap-2 text-sm font-bold text-white/85 underline-offset-4 transition-all duration-200 hover:underline"
            >
              {d.services.cta}
              <span aria-hidden="true">→</span>
            </a>
          </li>
        )
      }
    </ul>
  </div>
</section>
