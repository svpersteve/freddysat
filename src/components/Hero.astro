---
import { Image } from "astro:assets";
import CallPanel from "./CallPanel.astro";
import vanPhoto from "../assets/freddy-van.png";
import { pathFor, t, type Locale } from "../i18n";

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = t(locale);
const contact = pathFor(locale, "contact");

const photoAlt = {
  es: "Freddy, junto a su furgoneta rotulada, en una calle de Barcelona",
  en: "Freddy, beside his signwritten van on a Barcelona street",
}[locale];
---

<section class="border-b border-paper-edge bg-paper-shade">
  <div class="wrap py-10 md:py-14">
    <div class="grid gap-10 lg:grid-cols-[1.02fr_0.98fr] lg:items-center lg:gap-14">
      <div>
        <p class="label">{d.hero.label}</p>
        <h1 class="mt-4 text-[clamp(2.25rem,6vw,3.75rem)]">{d.hero.title}</h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-ink-70">{d.hero.lead}</p>
        <CallPanel locale={locale} class="mt-8" />
      </div>

      {/*
        The photograph is the argument. Every competing SAT in Barcelona is a
        call centre with a stock kitchen on its home page; this one can show
        the actual person who turns up and the van he arrives in, so it leads
        rather than sitting in an "about us" nobody reads.
      */}
      <figure class="relative">
        <Image
          src={vanPhoto}
          alt={photoAlt}
          widths={[480, 768, 1100]}
          sizes="(min-width: 1024px) 46vw, 100vw"
          class="w-full object-cover"
          loading="eager"
          fetchpriority="high"
        />
        <div class="rule-orange" aria-hidden="true"></div>
      </figure>
    </div>

    {/* Symptom-first triage. Nobody rings a SAT thinking "I need a washing
        machine technician" — they ring thinking "it won't drain". The chips are
        the site's navigation for that state of mind, and each one carries its
        symptom through to the contact form.

        Six, not eight: eight is a wall, six scans. The two that are not tiles
        are still live ?s= values -- see the note on the symptoms deck. */}
    <p class="label mt-12">{d.hero.pickSymptom}</p>
    <ul class="mt-4 grid grid-cols-2 gap-2 md:grid-cols-4">
      {
        d.symptoms.filter((s) => s.tile).map((s) => (
          <li>
            <a
              href={`${contact}?s=${s.id}`}
              class="group flex h-full flex-col justify-between gap-1 border border-steel bg-paper px-4 py-3 transition-all duration-200 hover:border-orange hover:bg-orange-wash focus-visible:border-orange"
            >
              <span class="font-display text-[0.9375rem] leading-tight text-ink">{s.label}</span>
              <span class="mt-1 text-xs leading-snug text-ink-45">{s.note}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
