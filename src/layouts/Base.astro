---
// Self-hosted, not Google's CDN. A stylesheet link to fonts.googleapis.com
// sends every visitor's IP to a third country on first paint, which for an EU
// site is a data transfer the privacy policy would have to declare.
import "@fontsource/archivo-black/latin-400.css";
import "@fontsource-variable/archivo/wght.css";
import "@fontsource-variable/oswald/wght.css";
import "../styles/global.css";

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CallBar from "../components/CallBar.astro";
import { BUSINESS, SITE_URL } from "../config/business";
import { alternatesFor, fill, t, type Locale, type PageKey } from "../i18n";

interface Props {
  locale: Locale;
  page: PageKey;
  title: string;
  description: string;
  /** Long-form pages (legal) set this to drop the sticky call bar and narrow the measure. */
  document?: boolean;
  /** Overrides the robots directive. Legal pages keep themselves out of the index. */
  robots?: string;
}

const { locale, page, title, description, document: isDocument = false, robots = "index, follow" } = Astro.props;
const d = t(locale);
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const alternates = alternatesFor(page);

// One LocalBusiness node, emitted on every page so any landing page can be the
// one Google reads. HVACBusiness is the closest schema.org type covering both
// halves of the trade.
//
// No PostalAddress: this is a service-area business and the Google profile
// carries no street address either. Publishing an invented one here would
// contradict the listing that already points at this domain, which is the
// fastest way to have both distrusted.
const schema = {
  "@context": "https://schema.org",
  "@type": "HVACBusiness",
  "@id": `${SITE_URL}/#business`,
  name: BUSINESS.name,
  description: fill(d.footer.blurb),
  url: SITE_URL,
  telephone: BUSINESS.phone.tel,
  image: `${SITE_URL}/brand/logo-square.svg`,
  logo: `${SITE_URL}/brand/logo-primary.svg`,
  sameAs: [BUSINESS.google.profileUrl],
  address: { "@type": "PostalAddress", addressLocality: BUSINESS.address.city, addressRegion: BUSINESS.address.region, addressCountry: BUSINESS.address.country },
  areaServed: { "@type": "City", name: BUSINESS.address.city },
  geo: { "@type": "GeoCoordinates", latitude: BUSINESS.geo.lat, longitude: BUSINESS.geo.lng },
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
      opens: BUSINESS.hours.open,
      closes: BUSINESS.hours.close,
    },
  ],
  makesOffer: d.catalogue.map((s) => ({
    "@type": "Offer",
    itemOffered: { "@type": "Service", name: s.name, description: s.blurb },
  })),
};
---

<!doctype html>
<html lang={d.htmlLang} dir={d.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {BUSINESS.name}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!robots.includes("noindex") &&
      alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={new URL(a.href, SITE_URL).href} />)}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={BUSINESS.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={d.htmlLang.replace("-", "_")} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#1a1a1a" />
    <meta name="robots" content={robots} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/brand/logo-avatar-250.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
  </head>

  <body class="min-h-screen flex flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-ink focus:px-4 focus:py-2 focus:text-white focus:text-sm"
      >{d.nav.skip}</a
    >

    <Header locale={locale} page={page} />

    <main id="main" class={isDocument ? "flex-1 py-14 md:py-20" : "flex-1"}>
      <slot />
    </main>

    <Footer locale={locale} />
    {!isDocument && <CallBar locale={locale} />}
  </body>
</html>
