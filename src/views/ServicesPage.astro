---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import TemperatureAxis from "../components/TemperatureAxis.astro";
import Trust from "../components/Trust.astro";
import Process from "../components/Process.astro";
import Faq from "../components/Faq.astro";
import CallPanel from "../components/CallPanel.astro";
import { fill, t, type Locale } from "../i18n";

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = t(locale);
---

<Base
  locale={locale}
  page="services"
  title={d.meta.servicesTitle}
  description={fill(d.meta.servicesDescription)}
>
  <PageHeader eyebrow={d.services.eyebrow} title={d.services.title} lead={d.services.lead} />
  <TemperatureAxis locale={locale} />
  <Trust locale={locale} />
  <Process locale={locale} />
  <Faq locale={locale} />

  <section class="py-16 md:py-24">
    <div class="wrap max-w-2xl">
      <h2 class="text-[clamp(1.875rem,4.5vw,2.75rem)]">{d.contact.title}</h2>
      <CallPanel locale={locale} class="mt-8" />
    </div>
  </section>
</Base>
