---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import TemperatureAxis from "../components/TemperatureAxis.astro";
import Trust from "../components/Trust.astro";
import Process from "../components/Process.astro";
import Faq from "../components/Faq.astro";
import CallPanel from "../components/CallPanel.astro";
import { fill, t, type Locale } from "../i18n";

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = t(locale);
---

<Base
  locale={locale}
  page="services"
  title={d.meta.servicesTitle}
  description={fill(d.meta.servicesDescription)}
>
  <PageHeader label={d.services.label} title={d.services.title} lead={d.services.lead} />
  <TemperatureAxis locale={locale} />

  {/*
    The sentence this trade's websites never write. Naming the certificate he
    does not hold is what keeps the site the right side of RD 115/2017, and
    said plainly it reads as competence rather than limitation — so it sits in
    the flow of the services page, not buried in the legal notice. Same strings
    as the FAQ entry, from one const in the dictionary.
  */}
  <section class="border-b border-paper-edge bg-white py-14 md:py-16">
    <div class="wrap">
      <div class="max-w-2xl border-l-2 border-orange bg-orange-wash px-6 py-6 md:px-8">
        <h2 class="font-display text-xl font-bold leading-tight">{d.boundary.title}</h2>
        <p class="mt-3 text-base leading-relaxed text-ink-70">{d.boundary.body}</p>
      </div>
    </div>
  </section>
  <Trust locale={locale} />
  <Process locale={locale} />
  <Faq locale={locale} />

  <section class="py-16 md:py-24">
    <div class="wrap max-w-2xl">
      <h2 class="text-[clamp(1.875rem,4.5vw,2.75rem)]">{d.contact.title}</h2>
      <CallPanel locale={locale} class="mt-8" />
    </div>
  </section>
</Base>
