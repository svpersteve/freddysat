---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import ContactForm from "../components/ContactForm.astro";
import CallPanel from "../components/CallPanel.astro";
import { AREAS, BUSINESS } from "../config/business";
import { fill, t, type Locale } from "../i18n";

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = t(locale);

// The email row only renders once a mailbox exists; the domain is not
// registered yet, so listing an address would advertise a dead inbox.
const rows = [
  { label: d.contact.phoneLabel, value: BUSINESS.phone.display, href: `tel:${BUSINESS.phone.tel}` },
  ...(BUSINESS.email ? [{ label: d.contact.emailLabel, value: BUSINESS.email, href: `mailto:${BUSINESS.email}` }] : []),
];
---

<Base
  locale={locale}
  page="contact"
  title={d.meta.contactTitle}
  description={fill(d.meta.contactDescription)}
>
  <PageHeader label={d.contact.label} title={d.contact.title} lead={d.contact.lead} />

  <section class="py-14 md:py-20">
    <div class="wrap grid gap-12 lg:grid-cols-[1fr_1fr] lg:gap-16">
      <div>
        <CallPanel locale={locale} />

        <dl class="mt-8 border-t border-paper-edge">
          {
            rows.map((row) => (
              <div class="flex items-baseline justify-between gap-4 border-b border-paper-edge py-4">
                <dt class="label">{row.label}</dt>
                <dd>
                  <a
                    href={row.href}
                    class="text-base font-bold text-ink tnum underline-offset-4 transition-all duration-200 hover:underline"
                    data-call-link={row.href.startsWith("tel:") ? true : undefined}
                  >
                    {row.value}
                  </a>
                </dd>
              </div>
            ))
          }
          <div class="flex items-baseline justify-between gap-4 border-b border-paper-edge py-4">
            <dt class="label">{d.contact.hoursLabel}</dt>
            <dd class="text-right text-sm">
              <span class="block font-bold tnum">{d.contact.everyDay} · {BUSINESS.hours.open}–{BUSINESS.hours.close}</span>
            </dd>
          </div>
          <div class="border-b border-paper-edge py-4">
            <dt class="label">{d.contact.areaLabel}</dt>
            <dd class="mt-2 text-sm leading-relaxed text-ink-70">{AREAS.join(" · ")}</dd>
          </div>
        </dl>
      </div>

      <ContactForm locale={locale} />
    </div>
  </section>
</Base>
