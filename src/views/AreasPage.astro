---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import AreaList from "../components/AreaList.astro";
import Process from "../components/Process.astro";
import CallPanel from "../components/CallPanel.astro";
import { fill, t, type Locale } from "../i18n";

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = t(locale);
---

<Base
  locale={locale}
  page="areas"
  title={d.meta.areasTitle}
  description={fill(d.meta.areasDescription)}
>
  <PageHeader label={d.areas.label} title={d.areas.title} lead={d.areas.lead} />
  <AreaList locale={locale} />
  <Process locale={locale} />

  <section class="py-16 md:py-24">
    <div class="wrap max-w-2xl">
      <h2 class="text-[clamp(1.875rem,4.5vw,2.75rem)]">{d.contact.title}</h2>
      <CallPanel locale={locale} class="mt-8" />
    </div>
  </section>
</Base>
