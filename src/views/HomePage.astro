---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import UrgentNotice from "../components/UrgentNotice.astro";
import TemperatureAxis from "../components/TemperatureAxis.astro";
import Trust from "../components/Trust.astro";
import Process from "../components/Process.astro";
import AreaList from "../components/AreaList.astro";
import Faq from "../components/Faq.astro";
import CallPanel from "../components/CallPanel.astro";
import { fill, t, type Locale } from "../i18n";

interface Props { locale: Locale }
const { locale } = Astro.props;
const d = t(locale);
---

<Base
  locale={locale}
  page="home"
  title={d.meta.homeTitle}
  description={fill(d.meta.homeDescription)}
>
  <Hero locale={locale} />
  <UrgentNotice locale={locale} />
  <TemperatureAxis locale={locale} />
  <Trust locale={locale} />
  <Process locale={locale} />
  <AreaList locale={locale} />
  <Faq locale={locale} />

  <section class="py-16 md:py-24">
    <div class="wrap max-w-2xl">
      <h2 class="text-[clamp(1.875rem,4.5vw,2.75rem)]">{d.contact.title}</h2>
      <p class="mt-4 text-lg leading-relaxed text-ink-70">{d.contact.lead}</p>
      <CallPanel locale={locale} class="mt-8" />
    </div>
  </section>
</Base>
