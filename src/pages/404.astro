---
// Served by Cloudflare for any unmatched path, in every language — so it is
// written to work for a visitor who arrived expecting Catalan or English.
// Castellano leads because it is the default locale.
import Base from "../layouts/Base.astro";
import { BUSINESS } from "../config/business";
import { DICTS, LOCALES, pathFor } from "../i18n";

const copy = {
  es: { title: "Esta página no existe", body: "El enlace es antiguo o tiene una errata. Vuelva al inicio o llámenos directamente." },
  ca: { title: "Aquesta pàgina no existeix", body: "L'enllaç és antic o té una errada. Torni a l'inici o truqui'ns directament." },
  en: { title: "This page doesn't exist", body: "The link is old or mistyped. Go back to the home page, or just call us." },
};
---

<Base locale="es" page="home" title={copy.es.title} description={copy.es.body} robots="noindex, nofollow" document>
  <div class="wrap wrap-narrow">
    <p class="label">Error 404</p>

    {
      LOCALES.map((locale) => (
        <section class="mt-10 border-t border-paper-edge pt-6" lang={DICTS[locale].htmlLang}>
          <h2 class="font-display text-2xl font-bold leading-tight">{copy[locale].title}</h2>
          <p class="mt-2 text-ink-70">{copy[locale].body}</p>
          <a href={pathFor(locale, "home")} class="mt-3 inline-block font-bold text-ink underline underline-offset-4">
            {DICTS[locale].nav.home} →
          </a>
        </section>
      ))
    }

    <a
      href={`tel:${BUSINESS.phone.tel}`}
      class="mt-10 inline-flex items-center gap-3 bg-orange px-6 py-4 label text-xl text-white transition-colors duration-200 hover:bg-orange-bright"
      data-call-link
    >
      {BUSINESS.phone.display}
    </a>
  </div>
</Base>
